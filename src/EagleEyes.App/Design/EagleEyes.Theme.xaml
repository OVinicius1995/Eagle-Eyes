<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Eagle Eyes: shared visual identity. See docs/IDENTIDADE-VISUAL.md. -->
  <SolidColorBrush x:Key="EagleEyes.Surface.Window" Color="#1B1B2B"/>
  <SolidColorBrush x:Key="EagleEyes.Surface.Input" Color="#232436"/>
  <SolidColorBrush x:Key="EagleEyes.Surface.Button" Color="#2B2C40"/>
  <SolidColorBrush x:Key="EagleEyes.Border.Control" Color="#414359"/>
  <SolidColorBrush x:Key="EagleEyes.Text.Primary" Color="#F1F2F8"/>
  <SolidColorBrush x:Key="EagleEyes.Text.Muted" Color="#B7B9CD"/>
  <SolidColorBrush x:Key="EagleEyes.Focus" Color="#8E96B7"/>
  <SolidColorBrush x:Key="EagleEyes.Action.Primary" Color="#2B7C53"/>
  <SolidColorBrush x:Key="EagleEyes.Action.PrimaryBorder" Color="#3A9B69"/>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource EagleEyes.Text.Primary}"/><Setter Property="Background" Value="{StaticResource EagleEyes.Surface.Button}"/><Setter Property="BorderBrush" Value="{StaticResource EagleEyes.Border.Control}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource EagleEyes.Text.Muted}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource EagleEyes.Text.Primary}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Background" Value="{StaticResource EagleEyes.Surface.Input}"/><Setter Property="BorderBrush" Value="{StaticResource EagleEyes.Border.Control}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="SelectionBrush" Value="#397F62"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource EagleEyes.Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{StaticResource EagleEyes.Text.Primary}"/><Setter Property="Padding" Value="10,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#3A3D55"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#34394E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource EagleEyes.Text.Primary}"/><Setter Property="Background" Value="{StaticResource EagleEyes.Surface.Input}"/><Setter Property="BorderBrush" Value="{StaticResource EagleEyes.Border.Control}"/><Setter Property="FontSize" Value="12"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{StaticResource EagleEyes.Surface.Input}" BorderBrush="{StaticResource EagleEyes.Border.Control}" BorderThickness="1" CornerRadius="6"><Path Data="M0,0 L4,4 L8,0" Stroke="{StaticResource EagleEyes.Text.Muted}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,0,31,0" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#282A3D" BorderBrush="{StaticResource EagleEyes.Border.Control}" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="240"><ScrollViewer Margin="3"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource EagleEyes.Focus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Box" Width="17" Height="17" HorizontalAlignment="Left" Background="{StaticResource EagleEyes.Surface.Input}" BorderBrush="#70748F" BorderThickness="1" CornerRadius="4"/><Path x:Name="Mark" Visibility="Collapsed" Data="M3,8 L7,12 L14,4" Width="17" Height="17" HorizontalAlignment="Left" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><ContentPresenter Grid.Column="1" VerticalAlignment="Center"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#2B7C53"/><Setter TargetName="Box" Property="BorderBrush" Value="#42996E"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource EagleEyes.Text.Muted}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="EagleEyes.Button.Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="19,9"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="MinWidth" Value="80"/>
  </Style>
  <Style x:Key="EagleEyes.Button.Primary" TargetType="Button" BasedOn="{StaticResource EagleEyes.Button.Secondary}">
    <Setter Property="Background" Value="{StaticResource EagleEyes.Action.Primary}"/>
    <Setter Property="BorderBrush" Value="{StaticResource EagleEyes.Action.PrimaryBorder}"/>
  </Style>
  <Style x:Key="EagleEyes.ToolTip.Hint" TargetType="ToolTip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource EagleEyes.Surface.Input}" BorderBrush="{StaticResource EagleEyes.Border.Control}"
                  BorderThickness="1" CornerRadius="6" Padding="10,7" MaxWidth="295">
            <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource EagleEyes.Text.Primary}" TextWrapping="Wrap"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
