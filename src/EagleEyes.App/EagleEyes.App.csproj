<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <Product>Eagle Eyes</Product>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../Assets/eagle-eyes.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="../EagleEyes.Core/EagleEyes.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="../../Assets/eagle-eyes.ico" Link="Assets/eagle-eyes.ico" />
    <Resource Include="../../Assets/eagle-eyes.png" Link="Assets/eagle-eyes.png" />
    <Content Include="../../Assets/eagle-eyes.ico" Link="Assets/eagle-eyes.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
